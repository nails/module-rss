{
    "name": "nails/module-rss",
    "description": "Define RSS feeds in code and serve them from Nails applications",
    "homepage": "https://docs.nailsapp.co.uk/modules/other/rss",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "nails/common": "dev-develop",
        "nails/module-cdn": "dev-develop",
        "nails/module-console": "dev-develop",
        "nails/module-cron": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nails\\Rss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Rss\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "extra": {
        "nails": {
            "moduleName": "rss",
            "type": "module",
            "namespace": "Nails\\Rss\\"
        }
    }
}
